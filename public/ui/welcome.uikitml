<!--
  AeroLab intro panel. Panel, Button, ButtonIcon and ButtonLabel come from the
  bundled Horizon kit; RectangleGoggles and LogIn are Lucide icons. UiSystem
  shows Enter XR in the browser and Exit in immersive mode.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 440px;
  }

  .panel-content {
    flex-direction: column;
    gap: 7px;
    padding-top: 22px;
    padding-left: 22px;
    padding-right: 22px;
    padding-bottom: 16px;
  }

  .eyebrow {
    color: #0a7f99;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #4fd8ff;
  }

  .heading {
    color: #1c1d20;
    font-size: 32px;
    font-weight: 700;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 17px;
  }

  .body:dark {
    color: #dddfe3;
  }

  .note {
    color: #5a6478;
    font-size: 12px;
    margin-top: 4px;
  }

  .note:dark {
    color: #8a96b0;
  }

  .button {
    justify-content: flex-start;
    margin-left: 22px;
    margin-right: 22px;
    margin-bottom: 22px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">VIRTUFORGE - HANDS-FIRST WIND TUNNEL</div>
    <div class="heading">AeroLab</div>
    <div class="body">1. Pinch a model button to load a car, plane, drone or wing.</div>
    <div class="body">2. Slide the lever for wind speed; pinch the knob and lift to tilt.</div>
    <div class="body">3. Pull the glowing handles to reshape the car.</div>
    <div class="body">4. Save A, change the design, then compare A vs B.</div>
    <div class="note">A 2D educational approximation for comparing designs, not validated CFD.</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
